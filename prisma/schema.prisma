// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  full_name String
  email     String   @unique
  phone     String
  role      Role     @default(USER)
  addresses User_Addresses[]
  measurements User_Measurements[]
  orders     Orders[]
  payments   Payment[]
  reviews    Reviews[]
  statusChanges OrderStatusHistory[]

  // @@schema("public")
}

enum Role {
  ADMIN
  USER

  // @@schema("public")
}

model User_Addresses {
  id          String      @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String  @db.Uuid
  full_name   String
  phone       String  
  country     String  @default("Nigeria")
  state       String
  city        String
  address     String
  postal_code String?
  is_default  Boolean? @default(false)
  user        User @relation(fields: [userId], references: [id])
  orders      Orders[]

  // @@schema("public")
}

model User_Measurements {
  id          String      @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String  @db.Uuid
  profile_name String
  gender      String
  chest       Float
  waist       Float
  hips        Float
  shoulder    Float
  sleeve_length Float
  arm           Float?
  sleeve_hem    Float?
  top_length    Float?
  thigh        Float
  trouser_length Float
  ankle        Float
  waist_to_knee  Float
  knee_to_ankle Float
  round_knee    Float
  inseam      Float?
  neck        Float
  height      Float?
  notes      String?
  user        User @relation(fields: [userId], references: [id])
  custom_orders Custom_Order[]

  // @@schema("public")
}

model Dresses {
  id          String      @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title        String
  slug         String   @unique
  description String
  category    DressCategory
  gender      Gender
  base_price   Float
  stock       Int
  soldCount   Int     @default(0)
  isPublished Boolean @default(false)
  thumbnail   String?
  images      Dress_Images[]
  orders      Order_Items[]
  custom_orders Custom_Order[]
  reviews      Reviews[]

  // @@schema("public")
}

enum DressCategory {
  FEMALE_NATIVE
  MALE_NATIVE
  CORPORATE_MALE
  CORPORATE_FEMALE
  CASUAL
  STREET_WEAR

  // @@schema("public")
}

enum Gender {
  MALE
  FEMALE
  UNISEX

  // @@schema("public")
}

model Dress_Images {
  id        String      @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dressId   String
  url       String
  storagePath String
  dress     Dresses @relation(fields: [dressId], references: [id])

  // @@schema("public")
}

model   Orders {
  id          String      @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String  @db.Uuid
  order_number String   @unique
  order_type   OrderType
  status      OrderStatus
  payment_status PaymentStatus
  delivery_method DeliveryMethod
  delivery_address_id String
  estimated_delivery DateTime?
  notes       String?
  user        User @relation(fields: [userId], references: [id])
  delivery_address User_Addresses @relation(fields: [delivery_address_id], references: [id])
  total       Float
  payment Payment?
  items        Order_Items[]
  custom_order Custom_Order?
  statusHistory OrderStatusHistory[]

  // @@schema("public")
}

enum OrderType {
  READY_MADE
  SEMI_CUSTOM
  FULL_CUSTOM

  // @@schema("public")
}

enum OrderStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  AWAITING_PAYMENT
  PAID
  IN_PRODUCTION
  READY_FOR_DELIVERY
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED

  // @@schema("public")
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  FAILED
  PENDING
  SUCCESS

  // @@schema("public")
}

enum DeliveryMethod {
  PICKUP
  LOCAL_DELIVERY
  SHIPPING

  // @@schema("public")
}

model OrderStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid

  orderId         String         
  order           Orders          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  oldStatus       OrderStatus?
  newStatus       OrderStatus

  changedById     String         @db.Uuid
  changedBy       User           @relation(fields: [changedById], references: [id])

  note            String?

  createdAt       DateTime       @default(now())
}

model Order_Items {
  id        String      @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderId   String
  dressId   String
  quantity  Int
  price     Float
  order     Orders @relation(fields: [orderId], references: [id])
  dress     Dresses @relation(fields: [dressId], references: [id])

  // @@schema("public")
}

model Custom_Order {
  id         String      @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderId     String   @unique
  idea_image_url String?
  selected_dress_id String?
  measurement_profile_id String?
  customization_notes String?
  customer_budget Decimal? @db.Decimal(10,2)
  admin_final_price Decimal? @db.Decimal(10,2)
  order       Orders @relation(fields: [orderId], references: [id])
  dress       Dresses? @relation(fields: [selected_dress_id], references: [id])
  measurements User_Measurements? @relation(fields: [measurement_profile_id], references: [id])

  // @@schema("public")
}

model Payment {
  id          String      @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String   @db.Uuid
  paidAt      DateTime
  orderId     String  @unique
  Provider    String  @default("PAYSTACK")
  Provider_Reference String @unique
  amount      Float
  status      PaymentStatus @default(UNPAID)
  order       Orders @relation(fields: [orderId], references: [id])
  user        User   @relation(fields: [userId], references: [id])
  // @@schema("public")
}

model Reviews {
  id          String      @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String  @db.Uuid
  dressId     String
  rating      Int
  comment     String
  user        User @relation(fields: [userId], references: [id])
  dress       Dresses @relation(fields: [dressId], references: [id])

  // @@schema("public")
}